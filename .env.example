# Clerk application authentication. Keep values in the deployment secret store.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Non-production review workspace only. Keep actual values in the deployment secret store.
REVIEW_DATABASE_URL=
CRON_SECRET=

# Read-only source mirror used only by the controlled baseline import CLI.
SOURCE_DATABASE_URL=
CBO_SOURCE_PROFILE=chicagohealthmap-public-v1

# Provider credentials are reserved for the hosted implementation; never commit values.
FIRECRAWL_API_KEY=
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_INTERACT_ALLOWLIST=
IRS_SEARCH_ENDPOINT=
TRUSTED_DIRECTORY_SEARCH_ENDPOINT=
VERCEL_BLOB_READ_WRITE_TOKEN=

# Azure OpenAI advisory scoring. Never give the review app an Azure database credential.
# Equity Azure OpenAI endpoint: https://equityclaudeagent.cognitiveservices.azure.com
# Production deployment: gpt-5.6-sol
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure handoff is disabled until the directory owner supplies an approved schema/key/version contract.
AZURE_EXPORT_MAPPING_JSON=

# Production publisher deployment only. This repository does not implement a publisher.
PUBLISHER_ENABLED=false
PRODUCTION_DATABASE_URL=
