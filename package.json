{
  "name": "cbo-chicago-scraper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "next build",
    "apply:baseline-import-migration": "psql \"$REVIEW_DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/004_baseline_imports.sql",
    "profile:cbo-source": "node scripts/profile-cbo-source.ts",
    "import:cbo-baseline": "node scripts/import-cbo-baseline.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.4",
    "@neondatabase/serverless": "^1.0.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.8.3"
  }
}
